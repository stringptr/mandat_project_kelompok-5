<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>01_check_master_empty</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Check if all master database tables are empty before running pipeline</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/06 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/06 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
  </order>
  <transform>
    <name>check_master_empty</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>Master</connection>
    <delete_field/>
    <execute_each_row>N</execute_each_row>
    <insert_field/>
    <quoteString>N</quoteString>
    <read_field/>
    <replace_variables>N</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>DO $$
DECLARE
  v_total INTEGER;
BEGIN
  SELECT COALESCE(SUM(c), 0) INTO v_total FROM (
    SELECT COUNT(*) AS c FROM lokasi
    UNION ALL SELECT COUNT(*) FROM user_account
    UNION ALL SELECT COUNT(*) FROM dinas_kesehatan
    UNION ALL SELECT COUNT(*) FROM bidan
    UNION ALL SELECT COUNT(*) FROM posyandu
    UNION ALL SELECT COUNT(*) FROM kader_posyandu
    UNION ALL SELECT COUNT(*) FROM pasien
    UNION ALL SELECT COUNT(*) FROM fasilitas_kesehatan
    UNION ALL SELECT COUNT(*) FROM pendidikan
    UNION ALL SELECT COUNT(*) FROM pekerjaan
    UNION ALL SELECT COUNT(*) FROM kategori_pendapatan
    UNION ALL SELECT COUNT(*) FROM ibu_hamil
    UNION ALL SELECT COUNT(*) FROM anak
    UNION ALL SELECT COUNT(*) FROM jadwal_imunisasi
    UNION ALL SELECT COUNT(*) FROM artikel
    UNION ALL SELECT COUNT(*) FROM hasil_pemeriksaan
    UNION ALL SELECT COUNT(*) FROM tindak_lanjut
    UNION ALL SELECT COUNT(*) FROM rujukan
    UNION ALL SELECT COUNT(*) FROM notifikasi
    UNION ALL SELECT COUNT(*) FROM user_session
    UNION ALL SELECT COUNT(*) FROM audit_log
  ) counts;
  IF v_total &gt; 0 THEN
    RAISE EXCEPTION 'Master database is not empty. Total rows: %', v_total;
  END IF;
END;
$$;</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
