  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
sql =
"INSERT INTO pendidikan (" +
"id_pendidikan,nama_pendidikan,jenjang,lama_tahun" +
") VALUES (" +
id_pendidikan + "," +
"'" + nama_pendidikan.replace(/'/g,"''") + "'," +
"'" + jenjang.replace(/'/g,"''") + "'," +
lama_tahun +
") ON CONFLICT (id_pendidikan) DO UPDATE SET " +
"nama_pendidikan=EXCLUDED.nama_pendidikan," +
"jenjang=EXCLUDED.jenjang," +
"lama_tahun=EXCLUDED.lama_tahun";
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>1000</length>
        <precision>-1</precision>
