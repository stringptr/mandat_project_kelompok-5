    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
sql =
"INSERT INTO public.user_account (" +
"id_user,email,password,no_hp,status_verifikasi," +
"nama,nik,jenis_kelamin,tanggal_lahir," +
"id_lokasi,id_pendidikan,id_pekerjaan,id_pendapatan," +
"jumlah_tanggungan,akun_ke,created_at,updated_at" +
") VALUES (" +

id_user + "," +

"'" + email.replace(/'/g,"''") + "'," +
"'" + password.replace(/'/g,"''") + "'," +
"'" + no_hp.replace(/'/g,"''") + "'," +

"'" + status_verifikasi + "'::status_verifikasi," +

"'" + nama.replace(/'/g,"''") + "'," +
"'" + nik + "'," +

"'" + jenis_kelamin + "'::jenis_kelamin," +

"'" + tanggal_lahir + "'," +

id_lokasi + "," +

(id_pendidikan==null ? "NULL" : id_pendidikan) + "," +
(id_pekerjaan==null ? "NULL" : id_pekerjaan) + "," +
(id_pendapatan==null ? "NULL" : id_pendapatan) + "," +

(jumlah_tanggungan==null ? "NULL" : jumlah_tanggungan) + "," +

(akun_ke==null ? "1" : akun_ke) + "," +

"'" + created_at + "'," +
"'" + updated_at + "'" +

") ON CONFLICT (id_user) DO UPDATE SET " +

"email=EXCLUDED.email," +
"password=EXCLUDED.password," +
"no_hp=EXCLUDED.no_hp," +
"status_verifikasi=EXCLUDED.status_verifikasi," +
"nama=EXCLUDED.nama," +
"nik=EXCLUDED.nik," +
"jenis_kelamin=EXCLUDED.jenis_kelamin," +
"tanggal_lahir=EXCLUDED.tanggal_lahir," +
"id_lokasi=EXCLUDED.id_lokasi," +
"id_pendidikan=EXCLUDED.id_pendidikan," +
"id_pekerjaan=EXCLUDED.id_pekerjaan," +
"id_pendapatan=EXCLUDED.id_pendapatan," +
"jumlah_tanggungan=EXCLUDED.jumlah_tanggungan," +
"akun_ke=EXCLUDED.akun_ke";</jsScript_script>
      </jsScript>
    </jsScripts>
