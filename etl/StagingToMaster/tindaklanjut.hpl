  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
// Escape text
var catatan = catatan_medis;
if (catatan != null) {
  catatan = catatan.replace(/'/g, "''");
}

var rekom = rekomendasi;
if (rekom != null) {
  rekom = rekom.replace(/'/g, "''");
}

sql =
"INSERT INTO public.tindak_lanjut (" +
"id_tindak_lanjut,id_hasil_pemeriksaan,id_bidan," +
"catatan_medis,rekomendasi,jadwal_kontrol,status_pasien," +
"created_at,updated_at" +
") VALUES (" +
id_tindak_lanjut + "," +
id_hasil_pemeriksaan + "," +
id_bidan + "," +
(catatan == null ? "NULL" : "'" + catatan + "'") + "," +
(rekom == null ? "NULL" : "'" + rekom + "'") + "," +
"'" + jadwal_kontrol + "'," +
"'" + status_pasien.trim() + "'::status_pasien," +
"'" + created_at + "'," +
"'" + updated_at + "'" +
") ON CONFLICT (id_tindak_lanjut) DO UPDATE SET " +
"id_hasil_pemeriksaan=EXCLUDED.id_hasil_pemeriksaan," +
"id_bidan=EXCLUDED.id_bidan," +
"catatan_medis=EXCLUDED.catatan_medis," +
"rekomendasi=EXCLUDED.rekomendasi," +
"jadwal_kontrol=EXCLUDED.jadwal_kontrol," +
"status_pasien=EXCLUDED.status_pasien";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>1000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>208</yloc>
    </GUI>
