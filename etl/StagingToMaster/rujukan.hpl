    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var alasan = alasan_rujukan;
if (alasan != null) {
  alasan = alasan.replace(/'/g, "''");
}

var status = status_rujukan;
if (status != null) {
  status = status.trim();
}

sql =
"INSERT INTO public.rujukan (" +
"id_rujukan,id_tindak_lanjut,alasan_rujukan," +
"tanggal_rujukan,status_rujukan,id_faskes," +
"created_at,updated_at" +
") VALUES (" +
id_rujukan + "," +
id_tindak_lanjut + "," +
"'" + alasan + "'," +
"'" + tanggal_rujukan + "'," +
"'" + status + "'::status_rujukan," +
id_faskes + "," +
"'" + created_at + "'," +
"'" + updated_at + "'" +
") ON CONFLICT (id_rujukan) DO UPDATE SET " +
"id_tindak_lanjut=EXCLUDED.id_tindak_lanjut," +
"alasan_rujukan=EXCLUDED.alasan_rujukan," +
"tanggal_rujukan=EXCLUDED.tanggal_rujukan," +
"status_rujukan=EXCLUDED.status_rujukan," +
"id_faskes=EXCLUDED.id_faskes";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>1000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>176</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>rujukan Staging</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    id_rujukan,
    id_tindak_lanjut,
    alasan_rujukan,
    tanggal_rujukan,
    status_rujukan,
    id_faskes,
    created_at,
    updated_at
FROM dbo.rujukan</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>48</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
