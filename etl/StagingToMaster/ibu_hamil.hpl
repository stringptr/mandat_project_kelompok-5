      <schema_name/>
    </partitioning>
    <connection>Staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    id_ibu_hamil,
    id_pasien,
    hamil_ke,
    bulan_mulai_hamil,
    hpht,
    status_kehamilan,
    created_at,
    updated_at
FROM dbo.ibu_hamil</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>64</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var status_fix = status_kehamilan;

if (status_fix != null) {
    status_fix = status_fix.toString();
    status_fix = status_fix.replace(/[\r\n]/g, "");
    status_fix = status_fix.replace(/^\s+|\s+$/g, "");
}

sql =
"INSERT INTO public.ibu_hamil (" +
"id_ibu_hamil,id_pasien,hamil_ke,bulan_mulai_hamil,hpht,status_kehamilan,created_at,updated_at" +
") VALUES (" +
id_ibu_hamil + "," +
id_pasien + "," +
hamil_ke + "," +
"'" + bulan_mulai_hamil + "'," +
"'" + hpht + "'," +
"'" + status_fix + "'::status_kehamilan," +
"'" + created_at + "'," +
"'" + updated_at + "'" +
") ON CONFLICT (id_ibu_hamil) DO UPDATE SET " +
"id_pasien=EXCLUDED.id_pasien," +
"hamil_ke=EXCLUDED.hamil_ke," +
"bulan_mulai_hamil=EXCLUDED.bulan_mulai_hamil," +
"hpht=EXCLUDED.hpht," +
"status_kehamilan=EXCLUDED.status_kehamilan";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>1000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>192</xloc>
      <yloc>208</yloc>
    </GUI>
