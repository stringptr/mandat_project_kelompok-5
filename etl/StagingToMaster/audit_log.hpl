    <limit>0</limit>
    <sql>SELECT
    id_log,
    tipe_aktor,
    id_user,
    id_user_session,
    tipe_aktivitas,
    berhasil,
    endpoint,
    table_name,
    record_id,
    old_value,
    new_value,
    detail,
    ip_address,
    user_agent,
    waktu_aktivitas
FROM dbo.audit_log;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
