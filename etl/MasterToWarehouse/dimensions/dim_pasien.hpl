<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_pasien</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load patient dimension with age calculation</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 12:30:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/13 16:30:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read Pasien with Calculations</from>
      <to>Write DIM_PASIEN</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read Pasien with Calculations</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>SELECT
  CASE
    WHEN EXISTS (SELECT 1 FROM anak a WHERE a.id_pasien = p.id_pasien) THEN 'Anak'::VARCHAR
    WHEN EXISTS (SELECT 1 FROM ibu_hamil ih WHERE ih.id_pasien = p.id_pasien) THEN 'Ibu Hamil'::VARCHAR
    ELSE 'Anak'::VARCHAR
  END AS tipe_pasien,
  p.id_pasien AS id_pasien_oltp,
  ua.jenis_kelamin::VARCHAR,
  -- Hitung usia berdasarkan tanggal_lahir dari user_account
  CASE
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt; 5
    THEN (EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir))::INT * 12
          + EXTRACT(MONTH FROM AGE(CURRENT_DATE, ua.tanggal_lahir))::INT)
    ELSE EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir))::INT
  END AS usia,
  CASE
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt; 5 THEN 'Bulan'::VARCHAR
    ELSE 'Tahun'::VARCHAR
  END AS satuan_usia,
  CASE
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt; 5  THEN 'Balita'::VARCHAR
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt;= 12 THEN 'Anak-Anak'::VARCHAR
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt;= 18 THEN 'Remaja'::VARCHAR
    ELSE 'Dewasa'::VARCHAR
  END AS kategori_usia,
  -- Nama kolom di tabel referensi sesuai skema Master
  pend.nama_pendidikan  AS pendidikan,
  pek.nama_pekerjaan    AS pekerjaan,
  kp.kategori_pendapatan,
  ua.jumlah_tanggungan
FROM pasien p
JOIN user_account ua ON p.id_pasien = ua.id_user
LEFT JOIN pendidikan        pend ON ua.id_pendidikan = pend.id_pendidikan
LEFT JOIN pekerjaan         pek  ON ua.id_pekerjaan  = pek.id_pekerjaan
LEFT JOIN kategori_pendapatan kp ON ua.id_pendapatan = kp.id_pendapatan</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write DIM_PASIEN</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_PASIEN</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
