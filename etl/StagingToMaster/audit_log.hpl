    </GUI>
  </transform>
  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
function esc(v) {
  if (v == null) return null;
  return v.toString().replace(/'/g, "''");
}

var endpointFix = esc(endpoint);
var tableFix = esc(table_name);
var recordFix = esc(record_id);
var detailFix = esc(detail);
var agentFix = esc(user_agent);
var ipFix = esc(ip_address);

var tipeAktorFix = tipe_aktor == null ? null : tipe_aktor.trim();
var aktivitasFix = tipe_aktivitas == null ? null : tipe_aktivitas.trim();

var berhasilFix;

if (berhasil == null) {
  berhasilFix = "NULL";
} else {
  berhasilFix =
    berhasil.toString().toLowerCase() == "true"
      ? "TRUE"
      : "FALSE";
}

sql =
"INSERT INTO public.audit_log (" +
"id_log,tipe_aktor,id_user,id_user_session," +
"tipe_aktivitas,berhasil,endpoint,table_name," +
"record_id,detail,ip_address,user_agent,waktu_aktivitas" +
") VALUES (" +
id_log + "," +
(tipeAktorFix == null ? "NULL" : "'" + tipeAktorFix + "'::tipe_aktor") + "," +
(id_user == null ? "NULL" : id_user) + "," +
(id_user_session == null ? "NULL" : "'" + id_user_session + "'") + "," +
(aktivitasFix == null ? "NULL" : "'" + aktivitasFix + "'::tipe_aktivitas") + "," +
berhasilFix + "," +
(endpointFix == null ? "NULL" : "'" + endpointFix + "'") + "," +
(tableFix == null ? "NULL" : "'" + tableFix + "'") + "," +
(recordFix == null ? "NULL" : "'" + recordFix + "'") + "," +
(detailFix == null ? "NULL" : "'" + detailFix + "'") + "," +
(ipFix == null ? "NULL" : "'" + ipFix + "'") + "," +
(agentFix == null ? "NULL" : "'" + agentFix + "'") + "," +
"'" + waktu_aktivitas + "'" +
") ON CONFLICT (id_log) DO UPDATE SET " +
"tipe_aktor=EXCLUDED.tipe_aktor," +
"id_user=EXCLUDED.id_user," +
"id_user_session=EXCLUDED.id_user_session," +
"tipe_aktivitas=EXCLUDED.tipe_aktivitas," +
"berhasil=EXCLUDED.berhasil," +
"endpoint=EXCLUDED.endpoint," +
"table_name=EXCLUDED.table_name," +
"record_id=EXCLUDED.record_id," +
"detail=EXCLUDED.detail," +
"ip_address=EXCLUDED.ip_address," +
"user_agent=EXCLUDED.user_agent";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>1000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>96</yloc>
    </GUI>
