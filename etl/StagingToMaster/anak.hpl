  <transform>
    <name>anak Staging</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    id_pasien,
    id_ibu_hamil,
    id_wali,
    nama_anak,
    berat_lahir,
    panjang_lahir,
    hubungan_dengan_wali,
    created_at,
    updated_at
FROM dbo.anak</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>208</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
function esc(v){
  return v == null ? "" : String(v).replace(/'/g,"''").trim();
}

sql =
"INSERT INTO public.anak (" +
"id_pasien,id_ibu_hamil,id_wali,nama_anak,berat_lahir,panjang_lahir,hubungan_dengan_wali,created_at,updated_at" +
") VALUES (" +
id_pasien + "," +
(id_ibu_hamil==null?"NULL":id_ibu_hamil) + "," +
id_wali + "," +
"'" + esc(nama_anak) + "'," +
berat_lahir + "," +
panjang_lahir + "," +
"'" + esc(hubungan_dengan_wali) + "'::hubungan_dengan_wali," +
"'" + created_at + "'," +
"'" + updated_at + "'" +
") ON CONFLICT (id_pasien) DO UPDATE SET " +
"id_ibu_hamil=EXCLUDED.id_ibu_hamil," +
"id_wali=EXCLUDED.id_wali," +
"nama_anak=EXCLUDED.nama_anak," +
"berat_lahir=EXCLUDED.berat_lahir," +
"panjang_lahir=EXCLUDED.panjang_lahir," +
"hubungan_dengan_wali=EXCLUDED.hubungan_dengan_wali";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>1000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>192</yloc>
    </GUI>
