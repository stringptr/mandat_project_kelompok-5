    email,
    password,
    no_hp,
    status_verifikasi,
    nama,
    nik,
    jenis_kelamin,
    tanggal_lahir,
    id_lokasi,
    id_pendidikan,
    id_pekerjaan,
    id_pendapatan,
    jumlah_tanggungan,
    akun_ke,
    created_at,
    updated_at
FROM dbo.user_account;</sql>
