<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_petugas</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Union all health workers (Bidan, Kader, Dinas) via user_account join</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 12:30:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/13 16:30:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read All Petugas</from>
      <to>Write DIM_PETUGAS</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read All Petugas</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>-- Tabel bidan/kader/dinas tidak punya kolom 'nama' sendiri
-- Nama petugas ada di user_account.nama
SELECT DISTINCT ua.nama AS nama_petugas, 'Bidan'::VARCHAR AS peran
FROM bidan b
JOIN user_account ua ON b.id_user = ua.id_user
UNION
SELECT DISTINCT ua.nama, 'Kader'::VARCHAR
FROM kader_posyandu kp
JOIN user_account ua ON kp.id_user = ua.id_user
UNION
SELECT DISTINCT ua.nama, 'Dinas Kesehatan'::VARCHAR
FROM dinas_kesehatan dk
JOIN user_account ua ON dk.id_user = ua.id_user</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write DIM_PETUGAS</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_PETUGAS</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
