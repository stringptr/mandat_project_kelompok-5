<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_posyandu</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load posyandu with bidan lookup - Incremental</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 12:30:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/14 22:50:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>00_Start_ETL_Log</from>
      <to>Read Posyandu</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read Posyandu</from>
      <to>Build SQL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build SQL</from>
      <to>Execute UPSERT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Execute UPSERT</from>
      <to>99_End_ETL_Log_Success</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>00_Start_ETL_Log</name>
    <type>TableInput</type>
    <description>Start ETL execution logging</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <sql>SELECT public.start_etl_execution(
    'MasterToWarehouse',
    'dim_posyandu',
    'RunAll',
    'posyandu',
    'DIM_POSYANDU',
    ('{"LAST_ETL_RUN": "' || COALESCE('${LAST_ETL_RUN}', '1900-01-01') || '"}')::JSONB
) as execution_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Read Posyandu</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>SELECT
  pos.id_posyandu      AS id_posyandu_oltp,
  pos.nama_posyandu,
  -- nama bidan dari user_account
  ua.nama              AS nama_bidan,
  -- wilayah_kerja ada di tabel bidan (FK ke lokasi.id_lokasi), ambil nama lokasinya
  lok.nama_lokasi      AS wilayah_kerja
FROM posyandu pos
JOIN bidan b         ON pos.id_bidan  = b.id_user
JOIN user_account ua ON b.id_user     = ua.id_user
JOIN lokasi lok      ON b.wilayah_kerja = lok.id_lokasi
WHERE (pos.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ OR b.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ OR ua.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ)
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build SQL</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
sql =
&quot;INSERT INTO public.DIM_POSYANDU (&quot; +
&quot;id_posyandu_oltp,nama_posyandu,id_petugas_bidan,wilayah_kerja&quot; +
&quot;) VALUES (&quot; +
&quot;'&quot; + id_posyandu_oltp + &quot;'::int8,&quot; +
&quot;'&quot; + nama_posyandu.replace(/'/g,&quot;''&quot;) + &quot;',&quot; +
&quot;(SELECT id_petugas FROM DIM_PETUGAS WHERE nama_petugas = '&quot; + nama_bidan.replace(/'/g,&quot;''&quot;) + &quot;' AND peran = 'Bidan'::peran_petugas LIMIT 1),&quot; +
&quot;'&quot; + wilayah_kerja.replace(/'/g,&quot;''&quot;) + &quot;'&quot; +
&quot;) ON CONFLICT (id_posyandu_oltp) DO UPDATE SET &quot; +
&quot;nama_posyandu = EXCLUDED.nama_posyandu,&quot; +
&quot;id_petugas_bidan = EXCLUDED.id_petugas_bidan,&quot; +
&quot;wilayah_kerja = EXCLUDED.wilayah_kerja &quot; +
&quot;WHERE DIM_POSYANDU.nama_posyandu IS DISTINCT FROM EXCLUDED.nama_posyandu &quot; +
&quot;OR DIM_POSYANDU.id_petugas_bidan IS DISTINCT FROM EXCLUDED.id_petugas_bidan &quot; +
&quot;OR DIM_POSYANDU.wilayah_kerja IS DISTINCT FROM EXCLUDED.wilayah_kerja&quot;;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>2000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute UPSERT</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Warehouse</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>99_End_ETL_Log_Success</name>
    <type>ExecSql</type>
    <description>End ETL execution logging with success status</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <execute_each_row>N</execute_each_row>
    <replace_variables>Y</replace_variables>
    <sql>SELECT public.end_etl_execution_success(
    '${execution_id}',
    0,  -- rows_inserted (will be updated by trigger if available)
    0,  -- rows_updated
    0   -- rows_deleted
)</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
