    <limit>0</limit>
    <sql>SELECT
    id_pendidikan,
    nama_pendidikan,
    jenjang,
    lama_tahun
FROM dbo.pendidikan</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>176</xloc>
      <yloc>176</yloc>
    </GUI>
