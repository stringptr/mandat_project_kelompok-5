  </transform>
  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var judulFix = judul;
if (judulFix != null) {
  judulFix = judulFix.replace(/'/g, "''");
}

var pesanFix = pesan;
if (pesanFix != null) {
  pesanFix = pesanFix.replace(/'/g, "''");
}

var tipeFix = tipe_notifikasi;
if (tipeFix != null) {
  tipeFix = tipeFix.trim();
}

var statusFix = status_baca;

if (statusFix == null) {
  statusFix = "FALSE";
} else {
  statusFix = (statusFix.toString().toLowerCase() == "true") ? "TRUE" : "FALSE";
}

sql =
"INSERT INTO public.notifikasi (" +
"id_notifikasi,id_user,judul,pesan,tipe_notifikasi,status_baca,tanggal_kirim" +
") VALUES (" +
id_notifikasi + "," +
id_user + "," +
"'" + judulFix + "'," +
(pesanFix == null ? "NULL" : "'" + pesanFix + "'") + "," +
"'" + tipeFix + "'::tipe_notifikasi," +
statusFix + "," +
"'" + tanggal_kirim + "'" +
") ON CONFLICT (id_notifikasi) DO UPDATE SET " +
"id_user=EXCLUDED.id_user," +
"judul=EXCLUDED.judul," +
"pesan=EXCLUDED.pesan," +
"tipe_notifikasi=EXCLUDED.tipe_notifikasi," +
"status_baca=EXCLUDED.status_baca," +
"tanggal_kirim=EXCLUDED.tanggal_kirim";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>1000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>128</yloc>
    </GUI>
