<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_lokasi</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flatten location hierarchy from Master to Warehouse - Incremental</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 12:30:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/14 22:50:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read Lokasi Hierarchy</from>
      <to>Build SQL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build SQL</from>
      <to>Execute UPSERT</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read Lokasi Hierarchy</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>SELECT DISTINCT
  kel.id_lokasi      AS id_lokasi_oltp,
  kel.nama_lokasi    AS nama_kelurahan,
  kec.nama_lokasi    AS nama_kecamatan,
  kab.nama_lokasi    AS nama_kabupaten,
  kot.nama_lokasi    AS nama_kota,
  prov.nama_lokasi   AS nama_provinsi
FROM lokasi kel
LEFT JOIN lokasi kec  ON kel.bagian_dari  = kec.id_lokasi  AND kec.tipe_lokasi  = 'Kecamatan'
LEFT JOIN lokasi kab  ON kec.bagian_dari  = kab.id_lokasi  AND kab.tipe_lokasi  = 'Kabupaten'
LEFT JOIN lokasi kot  ON kab.bagian_dari  = kot.id_lokasi  AND kot.tipe_lokasi  = 'Kota'
LEFT JOIN lokasi prov ON kot.bagian_dari  = prov.id_lokasi AND prov.tipe_lokasi = 'Provinsi'
WHERE kel.tipe_lokasi IN ('Kelurahan')</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build SQL</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var kelVal = (nama_kelurahan != null) ? &quot;'&quot; + nama_kelurahan.replace(/'/g,&quot;''&quot;) + &quot;'&quot; : &quot;NULL&quot;;
var kecVal = (nama_kecamatan != null) ? &quot;'&quot; + nama_kecamatan.replace(/'/g,&quot;''&quot;) + &quot;'&quot; : &quot;NULL&quot;;
var kabVal = (nama_kabupaten != null) ? &quot;'&quot; + nama_kabupaten.replace(/'/g,&quot;''&quot;) + &quot;'&quot; : &quot;NULL&quot;;
var kotVal = (nama_kota != null) ? &quot;'&quot; + nama_kota.replace(/'/g,&quot;''&quot;) + &quot;'&quot; : &quot;NULL&quot;;
var provVal = (nama_provinsi != null) ? &quot;'&quot; + nama_provinsi.replace(/'/g,&quot;''&quot;) + &quot;'&quot; : &quot;NULL&quot;;

sql =
&quot;INSERT INTO public.DIM_LOKASI (id_lokasi_oltp,nama_kelurahan,nama_kecamatan,nama_kabupaten,nama_kota,nama_provinsi) VALUES (&quot; +
&quot;'&quot; + id_lokasi_oltp + &quot;'::int,&quot; +
kelVal + &quot;,&quot; +
kecVal + &quot;,&quot; +
kabVal + &quot;,&quot; +
kotVal + &quot;,&quot; +
provVal +
&quot;) ON CONFLICT (id_lokasi_oltp) DO UPDATE SET &quot; +
&quot;nama_kelurahan = EXCLUDED.nama_kelurahan,&quot; +
&quot;nama_kecamatan = EXCLUDED.nama_kecamatan,&quot; +
&quot;nama_kabupaten = EXCLUDED.nama_kabupaten,&quot; +
&quot;nama_kota = EXCLUDED.nama_kota,&quot; +
&quot;nama_provinsi = EXCLUDED.nama_provinsi &quot; +
&quot;WHERE DIM_LOKASI.nama_kelurahan IS DISTINCT FROM EXCLUDED.nama_kelurahan &quot; +
&quot;OR DIM_LOKASI.nama_kecamatan IS DISTINCT FROM EXCLUDED.nama_kecamatan &quot; +
&quot;OR DIM_LOKASI.nama_kabupaten IS DISTINCT FROM EXCLUDED.nama_kabupaten &quot; +
&quot;OR DIM_LOKASI.nama_kota IS DISTINCT FROM EXCLUDED.nama_kota &quot; +
&quot;OR DIM_LOKASI.nama_provinsi IS DISTINCT FROM EXCLUDED.nama_provinsi&quot;;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>2000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute UPSERT</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Warehouse</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
