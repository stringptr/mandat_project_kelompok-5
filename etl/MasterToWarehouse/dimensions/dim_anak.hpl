<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_anak</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load child dimension (outrigger from DIM_PASIEN)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 13:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/13 15:20:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read Anak Data</from>
      <to>Add Tipe Pasien Const</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add Tipe Pasien Const</from>
      <to>Lookup id_dim_pasien</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup id_dim_pasien</from>
      <to>Write DIM_ANAK</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read Anak Data</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>SELECT 
  a.id_pasien,
  a.berat_lahir,
  a.panjang_lahir,
  a.hubungan_dengan_wali,
  a.id_ibu_hamil as id_ibu_hamil_oltp
FROM anak a</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Add Tipe Pasien Const</name>
    <type>Constant</type>
    <description>Inject literal 'Anak' untuk digunakan sebagai key lookup kedua ke DIM_PASIEN</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>tipe_pasien_const</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>Anak</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup id_dim_pasien</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_PASIEN</table>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <key>
        <name>id_pasien</name>
        <field>id_pasien_oltp</field>
        <condition>=</condition>
      </key>
      <key>
        <name>tipe_pasien_const</name>
        <field>tipe_pasien</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_dim_pasien</name>
        <rename>id_dim_pasien</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write DIM_ANAK</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_ANAK</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>id_dim_pasien</column_name>
        <stream_name>id_dim_pasien</stream_name>
      </field>
      <field>
        <column_name>berat_lahir</column_name>
        <stream_name>berat_lahir</stream_name>
      </field>
      <field>
        <column_name>panjang_lahir</column_name>
        <stream_name>panjang_lahir</stream_name>
      </field>
      <field>
        <column_name>hubungan_dengan_wali</column_name>
        <stream_name>hubungan_dengan_wali</stream_name>
      </field>
      <field>
        <column_name>id_ibu_hamil_oltp</column_name>
        <stream_name>id_ibu_hamil_oltp</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
