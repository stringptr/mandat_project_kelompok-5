  <transform>
    <name>lokasi Staging</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    id_lokasi,
    nama_lokasi,
    tipe_lokasi,
    bagian_dari
FROM dbo.lokasi</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

var parentValue;

if (bagian_dari == null) {
  parentValue = "NULL";
} else {
  parentValue = bagian_dari;
}

var nama = nama_lokasi;

if (nama != null) {
  nama = nama.replace(/'/g, "''");
}

sql =
"INSERT INTO public.lokasi (" +
"id_lokasi,nama_lokasi,tipe_lokasi,bagian_dari" +
") VALUES (" +
id_lokasi + "," +
"'" + nama_lokasi.replace(/'/g,"''") + "'," +
"'" + tipe_lokasi + "'::tipe_lokasi," +
(bagian_dari==null ? "NULL" : bagian_dari) +
") ON CONFLICT (id_lokasi) DO UPDATE SET " +
"nama_lokasi=EXCLUDED.nama_lokasi," +
"tipe_lokasi=EXCLUDED.tipe_lokasi," +
"bagian_dari=EXCLUDED.bagian_dari";

</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
