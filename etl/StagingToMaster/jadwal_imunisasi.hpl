  <transform>
    <name>jadwal_imunisasi Staging</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    id_imunisasi,
    id_pasien,
    nama_vaksin,
    tanggal_jadwal,
    tanggal_realisasi,
    status_imunisasi,
    created_at,
    updated_at
FROM dbo.jadwal_imunisasi</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
function esc(v){
  return v == null ? "" : String(v).replace(/'/g,"''").trim();
}

sql =
"INSERT INTO public.jadwal_imunisasi (" +
"id_imunisasi,id_pasien,nama_vaksin,tanggal_jadwal,tanggal_realisasi,status_imunisasi,created_at,updated_at" +
") VALUES (" +
id_imunisasi + "," +
id_pasien + "," +
"'" + esc(nama_vaksin) + "'," +
"'" + tanggal_jadwal + "'," +
(tanggal_realisasi==null ? "NULL" : "'" + tanggal_realisasi + "'") + "," +
"'" + esc(status_imunisasi) + "'::status_imunisasi," +
"'" + created_at + "'," +
"'" + updated_at + "'" +
") ON CONFLICT (id_imunisasi) DO UPDATE SET " +
"id_pasien=EXCLUDED.id_pasien," +
"nama_vaksin=EXCLUDED.nama_vaksin," +
"tanggal_jadwal=EXCLUDED.tanggal_jadwal," +
"tanggal_realisasi=EXCLUDED.tanggal_realisasi," +
"status_imunisasi=EXCLUDED.status_imunisasi";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>1000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute row SQL script</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Master</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>528</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
