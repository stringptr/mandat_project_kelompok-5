<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_pasien</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load patient dimension with age calculation - Incremental</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 12:30:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/14 22:50:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read Pasien with Calculations</from>
      <to>Build SQL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build SQL</from>
      <to>Execute UPSERT</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read Pasien with Calculations</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>SELECT
  CASE
    WHEN EXISTS (SELECT 1 FROM anak a WHERE a.id_pasien = p.id_pasien) THEN 'Anak'::VARCHAR
    WHEN EXISTS (SELECT 1 FROM ibu_hamil ih WHERE ih.id_pasien = p.id_pasien) THEN 'Ibu Hamil'::VARCHAR
    ELSE 'Anak'::VARCHAR
  END AS tipe_pasien,
  p.id_pasien AS id_pasien_oltp,
  ua.jenis_kelamin::VARCHAR,
  -- Hitung usia berdasarkan tanggal_lahir dari user_account
  CASE
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt; 5
    THEN (EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir))::INT * 12
          + EXTRACT(MONTH FROM AGE(CURRENT_DATE, ua.tanggal_lahir))::INT)
    ELSE EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir))::INT
  END AS usia,
  CASE
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt; 5 THEN 'Bulan'::VARCHAR
    ELSE 'Tahun'::VARCHAR
  END AS satuan_usia,
  CASE
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt; 5  THEN 'Balita'::VARCHAR
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt;= 12 THEN 'Anak-Anak'::VARCHAR
    WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, ua.tanggal_lahir)) &lt;= 18 THEN 'Remaja'::VARCHAR
    ELSE 'Dewasa'::VARCHAR
  END AS kategori_usia,
  -- Nama kolom di tabel referensi sesuai skema Master
  pend.nama_pendidikan  AS pendidikan,
  pek.nama_pekerjaan    AS pekerjaan,
  kp.kategori_pendapatan,
  ua.jumlah_tanggungan
FROM pasien p
JOIN user_account ua ON p.id_pasien = ua.id_user
LEFT JOIN pendidikan        pend ON ua.id_pendidikan = pend.id_pendidikan
LEFT JOIN pekerjaan         pek  ON ua.id_pekerjaan  = pek.id_pekerjaan
LEFT JOIN kategori_pendapatan kp ON ua.id_pendapatan = kp.id_pendapatan
WHERE (p.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ
   OR ua.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ)
  AND p.is_deleted = false
  AND ua.is_deleted = false</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build SQL</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
sql =
&quot;INSERT INTO public.DIM_PASIEN (&quot; +
&quot;tipe_pasien,id_pasien_oltp,jenis_kelamin,usia,satuan_usia,kategori_usia,pendidikan,pekerjaan,kategori_pendapatan,jumlah_tanggungan&quot; +
&quot;) VALUES (&quot; +
&quot;'&quot; + tipe_pasien + &quot;'::tipe_pasien,&quot; +
( id_pasien_oltp==null ? &quot;NULL&quot; : &quot;'&quot; + id_pasien_oltp + &quot;'::int8&quot; ) + &quot;,&quot; +
( jenis_kelamin==null ? &quot;NULL&quot; : &quot;'&quot; + jenis_kelamin.replace(/'/g,&quot;''&quot;) + &quot;'&quot; ) + &quot;,&quot; +
( usia==null ? &quot;NULL&quot; : &quot;'&quot; + usia + &quot;'::int8&quot; ) + &quot;,&quot; +
( satuan_usia==null ? &quot;NULL&quot; : &quot;'&quot; + satuan_usia.replace(/'/g,&quot;''&quot;) + &quot;'&quot; ) + &quot;,&quot; +
&quot;'&quot; + kategori_usia + &quot;'::kategori_usia,&quot; +
( pendidikan==null ? &quot;NULL&quot; : &quot;'&quot; + pendidikan.replace(/'/g,&quot;''&quot;) + &quot;'&quot; ) + &quot;,&quot; +
( pekerjaan==null ? &quot;NULL&quot; : &quot;'&quot; + pekerjaan.replace(/'/g,&quot;''&quot;) + &quot;'&quot; ) + &quot;,&quot; +
( kategori_pendapatan==null ? &quot;NULL&quot; : &quot;'&quot; + kategori_pendapatan.replace(/'/g,&quot;''&quot;) + &quot;'&quot; ) + &quot;,&quot; +
( jumlah_tanggungan==null ? &quot;NULL&quot; : &quot;'&quot; + jumlah_tanggungan + &quot;'::int8&quot; ) +
&quot;) ON CONFLICT (id_pasien_oltp, tipe_pasien) DO UPDATE SET &quot; +
&quot;jenis_kelamin = EXCLUDED.jenis_kelamin,&quot; +
&quot;usia = EXCLUDED.usia,&quot; +
&quot;satuan_usia = EXCLUDED.satuan_usia,&quot; +
&quot;kategori_usia = EXCLUDED.kategori_usia,&quot; +
&quot;pendidikan = EXCLUDED.pendidikan,&quot; +
&quot;pekerjaan = EXCLUDED.pekerjaan,&quot; +
&quot;kategori_pendapatan = EXCLUDED.kategori_pendapatan,&quot; +
&quot;jumlah_tanggungan = EXCLUDED.jumlah_tanggungan &quot; +
&quot;WHERE DIM_PASIEN.jenis_kelamin IS DISTINCT FROM EXCLUDED.jenis_kelamin &quot; +
&quot;OR DIM_PASIEN.usia IS DISTINCT FROM EXCLUDED.usia &quot; +
&quot;OR DIM_PASIEN.satuan_usia IS DISTINCT FROM EXCLUDED.satuan_usia &quot; +
&quot;OR DIM_PASIEN.kategori_usia IS DISTINCT FROM EXCLUDED.kategori_usia &quot; +
&quot;OR DIM_PASIEN.pendidikan IS DISTINCT FROM EXCLUDED.pendidikan &quot; +
&quot;OR DIM_PASIEN.pekerjaan IS DISTINCT FROM EXCLUDED.pekerjaan &quot; +
&quot;OR DIM_PASIEN.kategori_pendapatan IS DISTINCT FROM EXCLUDED.kategori_pendapatan &quot; +
&quot;OR DIM_PASIEN.jumlah_tanggungan IS DISTINCT FROM EXCLUDED.jumlah_tanggungan&quot;;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>3000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute UPSERT</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Warehouse</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
