  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
function esc(v){
  return v == null ? "" : String(v).replace(/'/g,"''").trim();
}

sql =
"INSERT INTO public.artikel (" +
"id_artikel,judul,isi_artikel,kategori,status_artikel,id_penulis,id_verifikator,tanggal_publish,created_at,updated_at" +
") VALUES (" +
id_artikel + "," +
"'" + esc(judul) + "'," +
"'" + esc(isi_artikel) + "'," +
(kategori==null?"NULL":"'" + esc(kategori) + "'") + "," +
"'" + esc(status_artikel) + "'::status_artikel," +
id_penulis + "," +
(id_verifikator==null?"NULL":id_verifikator) + "," +
(tanggal_publish==null?"NULL":"'" + tanggal_publish + "'") + "," +
"'" + created_at + "'," +
"'" + updated_at + "'" +
") ON CONFLICT (id_artikel) DO UPDATE SET " +
"judul=EXCLUDED.judul," +
"isi_artikel=EXCLUDED.isi_artikel," +
"kategori=EXCLUDED.kategori," +
"status_artikel=EXCLUDED.status_artikel";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>2000</length>
        <precision>-1</precision>
