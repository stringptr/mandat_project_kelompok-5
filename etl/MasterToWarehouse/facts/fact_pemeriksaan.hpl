  <transform>
    <name>Lookup id_petugas</name>
    <type>DBLookup</type>
    <description>Ambil id_petugas dari DIM_POSYANDU berdasarkan id_posyandu yang sudah di-resolve</description>
    <distribute>Y</distribute>
