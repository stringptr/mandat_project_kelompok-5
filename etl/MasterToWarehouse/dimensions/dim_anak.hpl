<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_anak</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load child dimension (outrigger from DIM_PASIEN) - Incremental</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 13:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/14 22:50:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>00_Start_ETL_Log</from>
      <to>Read Anak Data</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read Anak Data</from>
      <to>Build SQL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build SQL</from>
      <to>Execute UPSERT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Execute UPSERT</from>
      <to>99_End_ETL_Log_Success</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>00_Start_ETL_Log</name>
    <type>TableInput</type>
    <description>Start ETL execution logging</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <sql>SELECT public.start_etl_execution(
    'MasterToWarehouse',
    'dim_anak',
    'RunAll',
    'anak',
    'DIM_ANAK',
    ('{"LAST_ETL_RUN": "' || COALESCE('${LAST_ETL_RUN}', '1900-01-01') || '"}')::JSONB
) as execution_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Read Anak Data</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>SELECT 
  a.id_pasien,
  a.berat_lahir,
  a.panjang_lahir,
  a.hubungan_dengan_wali::VARCHAR,
  a.id_ibu_hamil as id_ibu_hamil_oltp
FROM anak a
WHERE a.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ
  AND a.is_deleted = false</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build SQL</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var ibuHamilVal = (id_ibu_hamil_oltp != null) ? &quot;'&quot; + id_ibu_hamil_oltp + &quot;'::int&quot; : &quot;NULL&quot;;
var dimPasienSubq = &quot;(SELECT id_dim_pasien FROM DIM_PASIEN WHERE id_pasien_oltp = '&quot; + id_pasien + &quot;' AND tipe_pasien = 'Anak'::tipe_pasien)&quot;;
var beratLahirVal = (berat_lahir != null) ? &quot;'&quot; + berat_lahir + &quot;'::numeric(5,2)&quot; : &quot;NULL&quot;;
var panjangLahirVal = (panjang_lahir != null) ? &quot;'&quot; + panjang_lahir + &quot;'::numeric(5,2)&quot; : &quot;NULL&quot;;
var hubWaliVal = (hubungan_dengan_wali != null) ? &quot;'&quot; + hubungan_dengan_wali.replace(/'/g,&quot;''&quot;) + &quot;'&quot; : &quot;NULL&quot;;

sql =
&quot;INSERT INTO public.DIM_ANAK (&quot; +
&quot;id_dim_pasien,berat_lahir,panjang_lahir,hubungan_dengan_wali,id_ibu_hamil_oltp&quot; +
&quot;) VALUES (&quot; +
dimPasienSubq + &quot;,&quot; +
beratLahirVal + &quot;,&quot; +
panjangLahirVal + &quot;,&quot; +
hubWaliVal + &quot;,&quot; +
ibuHamilVal +
&quot;) ON CONFLICT (id_dim_pasien) DO UPDATE SET &quot; +
&quot;berat_lahir = EXCLUDED.berat_lahir,&quot; +
&quot;panjang_lahir = EXCLUDED.panjang_lahir,&quot; +
&quot;hubungan_dengan_wali = EXCLUDED.hubungan_dengan_wali,&quot; +
&quot;id_ibu_hamil_oltp = EXCLUDED.id_ibu_hamil_oltp &quot; +
&quot;WHERE DIM_ANAK.berat_lahir IS DISTINCT FROM EXCLUDED.berat_lahir &quot; +
&quot;OR DIM_ANAK.panjang_lahir IS DISTINCT FROM EXCLUDED.panjang_lahir &quot; +
&quot;OR DIM_ANAK.hubungan_dengan_wali IS DISTINCT FROM EXCLUDED.hubungan_dengan_wali &quot; +
&quot;OR DIM_ANAK.id_ibu_hamil_oltp IS DISTINCT FROM EXCLUDED.id_ibu_hamil_oltp&quot;;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>2000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute UPSERT</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Warehouse</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>99_End_ETL_Log_Success</name>
    <type>ExecSql</type>
    <description>End ETL execution logging with success status</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <execute_each_row>N</execute_each_row>
    <replace_variables>Y</replace_variables>
    <sql>SELECT public.end_etl_execution_success(
    '${execution_id}',
    0,  -- rows_inserted (will be updated by trigger if available)
    0,  -- rows_updated
    0   -- rows_deleted
)</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
