<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>fact_imunisasi</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load immunization facts with dimensions lookup</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 13:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/13 16:30:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read Imunisasi Data</from>
      <to>Lookup id_waktu</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup id_waktu</from>
      <to>Lookup id_lokasi</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup id_lokasi</from>
      <to>Lookup id_dim_pasien</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup id_dim_pasien</from>
      <to>Lookup id_posyandu</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup id_posyandu</from>
      <to>Calculate Flags</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calculate Flags</from>
      <to>Write FACT_IMUNISASI</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read Imunisasi Data</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>-- Skema Master jadwal_imunisasi:
-- id_imunisasi, id_pasien, nama_vaksin, tanggal_jadwal, tanggal_realisasi, status_imunisasi
-- TIDAK ada: id_posyandu, tanggal_imunisasi
-- Posyandu diperoleh dari pasien.id_posyandu
-- Lokasi diperoleh dari user_account.id_lokasi (lokasi domisili pasien)
-- status_imunisasi ENUM: 'Sudah', 'Belum'
SELECT
  ji.id_imunisasi,
  -- Tanggal realisasi jika sudah terlaksana, tanggal_jadwal sebagai referensi
  COALESCE(ji.tanggal_realisasi, ji.tanggal_jadwal) AS tanggal_imunisasi,
  ji.tanggal_jadwal                                  AS tanggal_target,
  ji.id_pasien,
  p.id_posyandu                                      AS id_posyandu_oltp,
  ji.nama_vaksin,
  ji.status_imunisasi::VARCHAR,
  ua.id_lokasi                                       AS id_lokasi_oltp
FROM jadwal_imunisasi ji
JOIN pasien p        ON ji.id_pasien = p.id_pasien
JOIN user_account ua ON p.id_pasien  = ua.id_user</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup id_waktu</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_WAKTU</table>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <key>
        <name>tanggal_imunisasi</name>
        <field>tanggal</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_waktu</name>
        <rename>id_waktu</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>200</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup id_lokasi</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_LOKASI</table>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <key>
        <name>id_lokasi_oltp</name>
        <field>id_lokasi_oltp</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_lokasi</name>
        <rename>id_lokasi</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup id_dim_pasien</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_PASIEN</table>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <key>
        <name>id_pasien</name>
        <field>id_pasien_oltp</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_dim_pasien</name>
        <rename>id_dim_pasien</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>440</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup id_posyandu</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_POSYANDU</table>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <key>
        <name>id_posyandu_oltp</name>
        <field>id_posyandu_oltp</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_posyandu</name>
        <rename>id_posyandu</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Calculate Flags</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// status_imunisasi ENUM di Master: 'Sudah', 'Belum'
var flag_terlaksana = (status_imunisasi == 'Sudah') ? 1 : 0;

// Hitung keterlambatan
var flag_terlambat = 0;
var hari_keterlambatan = 0;

if (tanggal_imunisasi != null &amp;&amp; tanggal_target != null) {
    var dateImun   = new Date(tanggal_imunisasi);
    var dateTarget = new Date(tanggal_target);

    if (dateImun &gt; dateTarget) {
        flag_terlambat = 1;
        hari_keterlambatan = Math.floor((dateImun - dateTarget) / (1000 * 60 * 60 * 24));
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>flag_terlaksana</name>
        <rename>flag_terlaksana</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>flag_terlambat</name>
        <rename>flag_terlambat</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>hari_keterlambatan</name>
        <rename>hari_keterlambatan</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>680</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write FACT_IMUNISASI</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>FACT_IMUNISASI</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>id_waktu</column_name>
        <stream_name>id_waktu</stream_name>
      </field>
      <field>
        <column_name>id_lokasi</column_name>
        <stream_name>id_lokasi</stream_name>
      </field>
      <field>
        <column_name>id_dim_pasien</column_name>
        <stream_name>id_dim_pasien</stream_name>
      </field>
      <field>
        <column_name>id_posyandu</column_name>
        <stream_name>id_posyandu</stream_name>
      </field>
      <field>
        <column_name>nama_vaksin</column_name>
        <stream_name>nama_vaksin</stream_name>
      </field>
      <field>
        <column_name>status_imunisasi</column_name>
        <stream_name>status_imunisasi</stream_name>
      </field>
      <field>
        <column_name>flag_terlaksana</column_name>
        <stream_name>flag_terlaksana</stream_name>
      </field>
      <field>
        <column_name>flag_terlambat</column_name>
        <stream_name>flag_terlambat</stream_name>
      </field>
      <field>
        <column_name>hari_keterlambatan</column_name>
        <stream_name>hari_keterlambatan</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
