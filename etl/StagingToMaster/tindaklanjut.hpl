    <sql>SELECT
    id_tindak_lanjut,
    id_hasil_pemeriksaan,
    id_bidan,
    catatan_medis,
    rekomendasi,
    jadwal_kontrol,
    status_pasien,
    created_at,
    updated_at
FROM dbo.tindak_lanjut</sql>
