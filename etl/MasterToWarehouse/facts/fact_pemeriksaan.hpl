  <transform>
    <name>Calculate Flags</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Calculate flags berdasarkan kolom yang tersedia di skema Master
// status_stunting ENUM: 'Normal','Berisiko Stunting','Stunting','Stunting Berat'
var flag_stunting = (status_stunting == 'Stunting' || status_stunting == 'Stunting Berat') ? 1 : 0;
// status_gizi ENUM: 'Gizi Baik','Gizi Kurang','Gizi Buruk','Risiko Gizi Lebih','Gizi Lebih','Obesitas'
var flag_gizi_buruk = (status_gizi == 'Gizi Buruk') ? 1 : 0;
// status_perlu_rujukan di-derive dari tindak_lanjut.status_pasien
var flag_perlu_rujukan = (status_perlu_rujukan == 'Perlu Rujukan') ? 1 : 0;
// flag_kek dan flag_anemia: lila/hemoglobin tidak ada di skema, derive dari status_gizi untuk ibu
var flag_kek = (tipe_pasien == 'Ibu Hamil' &amp;&amp; (status_gizi == 'Gizi Kurang' || status_gizi == 'Gizi Buruk')) ? 1 : 0;
var flag_anemia = 0; // Tidak ada kolom hemoglobin di skema Master
var flag_risiko_tinggi = ((flag_kek + flag_anemia + flag_perlu_rujukan) &gt; 0) ? 1 : 0;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>flag_stunting</name>
        <rename>flag_stunting</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>flag_gizi_buruk</name>
        <rename>flag_gizi_buruk</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>flag_perlu_rujukan</name>
        <rename>flag_perlu_rujukan</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>flag_kek</name>
        <rename>flag_kek</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>flag_anemia</name>
        <rename>flag_anemia</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>flag_risiko_tinggi</name>
        <rename>flag_risiko_tinggi</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>920</xloc>
      <yloc>80</yloc>
    </GUI>
