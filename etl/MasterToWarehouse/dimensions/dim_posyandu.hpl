<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_posyandu</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load posyandu with bidan lookup</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 12:30:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/13 16:30:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read Posyandu</from>
      <to>Lookup Bidan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Bidan</from>
      <to>Write DIM_POSYANDU</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read Posyandu</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>SELECT
  pos.id_posyandu      AS id_posyandu_oltp,
  pos.nama_posyandu,
  -- nama bidan dari user_account
  ua.nama              AS nama_bidan,
  -- wilayah_kerja ada di tabel bidan (FK ke lokasi.id_lokasi), ambil nama lokasinya
  lok.nama_lokasi      AS wilayah_kerja
FROM posyandu pos
JOIN bidan b         ON pos.id_bidan  = b.id_user
JOIN user_account ua ON b.id_user     = ua.id_user
JOIN lokasi lok      ON b.wilayah_kerja = lok.id_lokasi</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup Bidan</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_PETUGAS</table>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <key>
        <name>nama_bidan</name>
        <field>nama_petugas</field>
        <condition>=</condition>
      </key>
      <key>
        <name>'Bidan'</name>
        <field>peran</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_petugas</name>
        <rename>id_petugas_bidan</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write DIM_POSYANDU</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <schema>public</schema>
    <table>DIM_POSYANDU</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>id_posyandu_oltp</column_name>
        <stream_name>id_posyandu_oltp</stream_name>
      </field>
      <field>
        <column_name>nama_posyandu</column_name>
        <stream_name>nama_posyandu</stream_name>
      </field>
      <field>
        <column_name>id_petugas_bidan</column_name>
        <stream_name>id_petugas_bidan</stream_name>
      </field>
      <field>
        <column_name>wilayah_kerja</column_name>
        <stream_name>wilayah_kerja</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
