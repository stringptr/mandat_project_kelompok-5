  <order>
    <hop>
      <from>jadwal_imunisasi Staging</from>
      <to>JavaScript</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>JavaScript</from>
      <to>Execute row SQL script</to>
      <enabled>Y</enabled>
    </hop>
