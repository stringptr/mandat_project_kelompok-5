<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>fact_imunisasi</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load immunization facts with dimensions lookup - Incremental</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 13:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/14 22:50:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read Imunisasi Data</from>
      <to>Build SQL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build SQL</from>
      <to>Execute UPSERT</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read Imunisasi Data</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>-- Skema Master jadwal_imunisasi:
-- id_imunisasi, id_pasien, nama_vaksin, tanggal_jadwal, tanggal_realisasi, status_imunisasi
-- TIDAK ada: id_posyandu, tanggal_imunisasi
-- Posyandu diperoleh dari pasien.id_posyandu
-- Lokasi diperoleh dari user_account.id_lokasi (lokasi domisili pasien)
-- status_imunisasi ENUM: 'Sudah', 'Belum'
SELECT
  ji.id_imunisasi,
  -- Tanggal realisasi jika sudah terlaksana, tanggal_jadwal sebagai referensi
  COALESCE(ji.tanggal_realisasi, ji.tanggal_jadwal) AS tanggal_imunisasi,
  ji.tanggal_jadwal                                  AS tanggal_target,
  ji.id_pasien,
  p.id_posyandu                                      AS id_posyandu_oltp,
  ji.nama_vaksin,
  ji.status_imunisasi::VARCHAR,
  ua.id_lokasi                                       AS id_lokasi_oltp
FROM jadwal_imunisasi ji
JOIN pasien p        ON ji.id_pasien = p.id_pasien
JOIN user_account ua ON p.id_pasien  = ua.id_user
WHERE ji.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ
  AND p.is_deleted = false AND ua.is_deleted = false</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build SQL</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var flag_terlaksana = (status_imunisasi == 'Sudah') ? 1 : 0;
var flag_terlambat = 0;
var hari_keterlambatan = 0;

if (tanggal_imunisasi != null &amp;&amp; tanggal_target != null) {
    var dateImun   = new Date(tanggal_imunisasi);
    var dateTarget = new Date(tanggal_target);

    if (dateImun &gt; dateTarget) {
        flag_terlambat = 1;
        hari_keterlambatan = Math.floor((dateImun - dateTarget) / (1000 * 60 * 60 * 24));
    }
}

sql =
&quot;INSERT INTO public.FACT_IMUNISASI (&quot; +
&quot;id_imunisasi_oltp,id_waktu,id_lokasi,id_dim_pasien,id_posyandu,nama_vaksin,status_imunisasi,flag_terlaksana,flag_terlambat,hari_keterlambatan&quot; +
&quot;) VALUES (&quot; +
&quot;'&quot; + id_imunisasi + &quot;'::int,&quot; +
&quot;(SELECT id_waktu FROM DIM_WAKTU WHERE tanggal = '&quot; + tanggal_imunisasi + &quot;'::date),&quot; +
&quot;(SELECT id_lokasi FROM DIM_LOKASI WHERE id_lokasi_oltp = '&quot; + id_lokasi_oltp + &quot;'::int),&quot; +
&quot;(SELECT id_dim_pasien FROM DIM_PASIEN WHERE id_pasien_oltp = '&quot; + id_pasien + &quot;'::int LIMIT 1),&quot; +
&quot;(SELECT id_posyandu FROM DIM_POSYANDU WHERE id_posyandu_oltp = '&quot; + id_posyandu_oltp + &quot;'::int),&quot; +
&quot;'&quot; + nama_vaksin.replace(/'/g,&quot;''&quot;) + &quot;',&quot; +
&quot;'&quot; + status_imunisasi.replace(/'/g,&quot;''&quot;) + &quot;',&quot; +
&quot;'&quot; + flag_terlaksana + &quot;'::int,&quot; +
&quot;'&quot; + flag_terlambat + &quot;'::int,&quot; +
&quot;'&quot; + hari_keterlambatan + &quot;'::int&quot; +
&quot;) ON CONFLICT (id_imunisasi_oltp) DO UPDATE SET &quot; +
&quot;id_waktu = EXCLUDED.id_waktu,&quot; +
&quot;id_lokasi = EXCLUDED.id_lokasi,&quot; +
&quot;id_dim_pasien = EXCLUDED.id_dim_pasien,&quot; +
&quot;id_posyandu = EXCLUDED.id_posyandu,&quot; +
&quot;nama_vaksin = EXCLUDED.nama_vaksin,&quot; +
&quot;status_imunisasi = EXCLUDED.status_imunisasi,&quot; +
&quot;flag_terlaksana = EXCLUDED.flag_terlaksana,&quot; +
&quot;flag_terlambat = EXCLUDED.flag_terlambat,&quot; +
&quot;hari_keterlambatan = EXCLUDED.hari_keterlambatan &quot; +
&quot;WHERE FACT_IMUNISASI.id_waktu IS DISTINCT FROM EXCLUDED.id_waktu &quot; +
&quot;OR FACT_IMUNISASI.id_lokasi IS DISTINCT FROM EXCLUDED.id_lokasi &quot; +
&quot;OR FACT_IMUNISASI.id_dim_pasien IS DISTINCT FROM EXCLUDED.id_dim_pasien &quot; +
&quot;OR FACT_IMUNISASI.id_posyandu IS DISTINCT FROM EXCLUDED.id_posyandu &quot; +
&quot;OR FACT_IMUNISASI.nama_vaksin IS DISTINCT FROM EXCLUDED.nama_vaksin &quot; +
&quot;OR FACT_IMUNISASI.status_imunisasi IS DISTINCT FROM EXCLUDED.status_imunisasi &quot; +
&quot;OR FACT_IMUNISASI.flag_terlaksana IS DISTINCT FROM EXCLUDED.flag_terlaksana &quot; +
&quot;OR FACT_IMUNISASI.flag_terlambat IS DISTINCT FROM EXCLUDED.flag_terlambat &quot; +
&quot;OR FACT_IMUNISASI.hari_keterlambatan IS DISTINCT FROM EXCLUDED.hari_keterlambatan&quot;;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>flag_terlaksana</name>
        <rename>flag_terlaksana</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>flag_terlambat</name>
        <rename>flag_terlambat</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>hari_keterlambatan</name>
        <rename>hari_keterlambatan</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>3000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute UPSERT</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Warehouse</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
