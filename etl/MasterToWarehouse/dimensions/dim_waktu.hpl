<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_waktu</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generate calendar dimension (2020-2030) - Incremental</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 12:30:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/14 22:50:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>00_Start_ETL_Log</from>
      <to>Generate Calendar</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Generate Calendar</from>
      <to>Build SQL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build SQL</from>
      <to>Execute UPSERT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Execute UPSERT</from>
      <to>99_End_ETL_Log_Success</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>00_Start_ETL_Log</name>
    <type>TableInput</type>
    <description>Start ETL execution logging</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <sql>SELECT public.start_etl_execution(
    'MasterToWarehouse',
    'dim_waktu',
    'RunAll',
    'generate_series',
    'DIM_WAKTU',
    '{}'::JSONB
) as execution_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Generate Calendar</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <sql>SELECT 
  TO_CHAR(d.tanggal, 'YYYYMMDD')::INT as id_waktu,
  d.tanggal,
  EXTRACT(YEAR FROM d.tanggal)::INT as tahun,
  CASE WHEN EXTRACT(MONTH FROM d.tanggal) &lt;= 6 THEN 1 ELSE 2 END as semester,
  EXTRACT(QUARTER FROM d.tanggal)::INT as kuartal,
  EXTRACT(MONTH FROM d.tanggal)::INT as bulan,
  TRIM(TO_CHAR(d.tanggal, 'Month')) as nama_bulan,
  EXTRACT(WEEK FROM d.tanggal)::INT as minggu
FROM generate_series(
  '2020-01-01'::DATE,
  '2030-12-31'::DATE,
  '1 day'::INTERVAL
) AS d(tanggal)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build SQL</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
sql =
&quot;INSERT INTO public.DIM_WAKTU (id_waktu,tanggal,tahun,semester,kuartal,bulan,nama_bulan,minggu) VALUES (&quot; +
&quot;'&quot; + id_waktu + &quot;'::int,&quot; +
&quot;'&quot; + tanggal + &quot;'::date,&quot; +
&quot;'&quot; + tahun + &quot;'::int,&quot; +
&quot;'&quot; + semester + &quot;'::int,&quot; +
&quot;'&quot; + kuartal + &quot;'::int,&quot; +
&quot;'&quot; + bulan + &quot;'::int,&quot; +
&quot;'&quot; + nama_bulan.replace(/'/g,&quot;''&quot;) + &quot;',&quot; +
&quot;'&quot; + minggu + &quot;'::int&quot; +
&quot;) ON CONFLICT (id_waktu) DO NOTHING&quot;;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>2000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute UPSERT</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Warehouse</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>99_End_ETL_Log_Success</name>
    <type>ExecSql</type>
    <description>End ETL execution logging with success status</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <execute_each_row>N</execute_each_row>
    <replace_variables>Y</replace_variables>
    <sql>SELECT public.end_etl_execution_success(
    '${execution_id}',
    0,  -- rows_inserted (will be updated by trigger if available)
    0,  -- rows_updated
    0   -- rows_deleted
)</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
