<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>fact_pemeriksaan</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load health examination facts with all dimensions lookup - Incremental</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 13:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/16 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>00_Start_ETL_Log</from>
      <to>Read Pemeriksaan Data</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read Pemeriksaan Data</from>
      <to>Build SQL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build SQL</from>
      <to>Execute UPSERT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Execute UPSERT</from>
      <to>99_End_ETL_Log_Success</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>00_Start_ETL_Log</name>
    <type>TableInput</type>
    <description>Start ETL execution logging</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <sql>SELECT public.start_etl_execution(
    'MasterToWarehouse',
    'fact_pemeriksaan',
    'RunAll',
    'hasil_pemeriksaan',
    'FACT_PEMERIKSAAN',
    ('{"LAST_ETL_RUN": "' || COALESCE('${LAST_ETL_RUN}', '1900-01-01') || '"}')::JSONB
) as execution_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Read Pemeriksaan Data</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>-- Skema Master:
-- hasil_pemeriksaan: id_hasil_pemeriksaan, id_petugas_input, id_jadwal_imunisasi,
--                   berat_badan, tinggi_badan, lingkar_kepala, tekanan_darah,
--                   status_stunting, status_gizi, catatan
-- jadwal_imunisasi: id_imunisasi, id_pasien, nama_vaksin, tanggal_jadwal,
--                   tanggal_realisasi, status_imunisasi
-- pasien: id_pasien, id_posyandu
-- user_account: id_lokasi (lokasi domisili pasien)
-- Tidak ada kolom lila/hemoglobin/status_perlu_rujukan di hasil_pemeriksaan
-- Flag kek dan anemia di-derive dari tindak_lanjut jika ada, atau dari status_gizi
SELECT
  hp.id_hasil_pemeriksaan,
  hp.id_jadwal_imunisasi              AS id_jadwal_imunisasi_oltp,
  -- Tanggal realisasi imunisasi sebagai tanggal pemeriksaan
  -- Jika belum terealisasi, pakai tanggal_jadwal sebagai fallback
  COALESCE(ji.tanggal_realisasi, ji.tanggal_jadwal) AS tanggal_pemeriksaan,
  ji.id_pasien,
  p.id_posyandu                       AS id_posyandu_oltp,
  ua.id_lokasi                        AS id_lokasi_oltp,
  hp.berat_badan,
  hp.tinggi_badan,
  hp.lingkar_kepala,
  hp.tekanan_darah,
  hp.status_stunting::VARCHAR,
  hp.status_gizi::VARCHAR,
  -- status_perlu_rujukan di-derive: ada di tindak_lanjut.status_pasien
  COALESCE((SELECT tl.status_pasien::VARCHAR FROM tindak_lanjut tl WHERE tl.id_hasil_pemeriksaan = hp.id_hasil_pemeriksaan LIMIT 1), 'Dalam Pemantauan') AS status_perlu_rujukan,
  -- lila dan hemoglobin tidak ada di skema; set 0 agar flag_kek/flag_anemia = 0 untuk anak
  -- untuk ibu hamil, derive dari status_gizi
  0::NUMERIC                          AS lila,
  0::NUMERIC                          AS hemoglobin,
  ih.id_ibu_hamil                     AS id_ibu_hamil_oltp,
  CASE
    WHEN EXISTS (SELECT 1 FROM anak a WHERE a.id_pasien = ji.id_pasien) THEN 'Anak'
    ELSE 'Ibu Hamil'
  END                                 AS tipe_pasien,
  -- id_petugas_input untuk lookup ke DIM_PETUGAS via user_account
  hp.id_petugas_input
FROM hasil_pemeriksaan hp
JOIN jadwal_imunisasi ji  ON hp.id_jadwal_imunisasi = ji.id_imunisasi
JOIN pasien p             ON ji.id_pasien           = p.id_pasien
JOIN user_account ua      ON p.id_pasien            = ua.id_user
LEFT JOIN ibu_hamil ih    ON ih.id_pasien           = ji.id_pasien
WHERE hp.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build SQL</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var flag_stunting = (status_stunting == 'Stunting' || status_stunting == 'Stunting Berat') ? 1 : 0;
var flag_gizi_buruk = (status_gizi == 'Gizi Buruk') ? 1 : 0;
var flag_perlu_rujukan = (status_perlu_rujukan == 'Perlu Rujukan') ? 1 : 0;
var flag_kek = (tipe_pasien == 'Ibu Hamil' &amp;&amp; (status_gizi == 'Gizi Kurang' || status_gizi == 'Gizi Buruk')) ? 1 : 0;
var flag_anemia = 0;
var flag_risiko_tinggi = ((flag_kek + flag_anemia + flag_perlu_rujukan) &gt; 0) ? 1 : 0;

var id_waktu_subq = &quot;(SELECT id_waktu FROM DIM_WAKTU WHERE tanggal = '&quot; + tanggal_pemeriksaan + &quot;'::date)&quot;;
var id_lokasi_subq = &quot;(SELECT id_lokasi FROM DIM_LOKASI WHERE id_lokasi_oltp = '&quot; + id_lokasi_oltp + &quot;'::int)&quot;;
var id_dim_pasien_subq = &quot;(SELECT id_dim_pasien FROM DIM_PASIEN WHERE id_pasien_oltp = '&quot; + id_pasien + &quot;'::int AND tipe_pasien = '&quot; + tipe_pasien + &quot;'::tipe_pasien)&quot;;
var id_posyandu_subq = &quot;(SELECT id_posyandu FROM DIM_POSYANDU WHERE id_posyandu_oltp = '&quot; + id_posyandu_oltp + &quot;'::int)&quot;;
var id_dim_kehamilan_subq = (id_ibu_hamil_oltp != null) ? &quot;(SELECT id_dim_ibu_hamil FROM DIM_IBU_HAMIL WHERE id_ibu_hamil_oltp = '&quot; + id_ibu_hamil_oltp + &quot;'::int)&quot; : &quot;NULL&quot;;
var id_petugas_subq = &quot;(SELECT id_petugas_bidan FROM DIM_POSYANDU WHERE id_posyandu_oltp = '&quot; + id_posyandu_oltp + &quot;'::int)&quot;;

sql =
&quot;INSERT INTO public.FACT_PEMERIKSAAN (&quot; +
&quot;id_hasil_pemeriksaan_oltp,id_jadwal_imunisasi_oltp,id_waktu,id_lokasi,id_dim_pasien,id_posyandu,id_dim_kehamilan,tipe_pasien,id_petugas,berat_badan,tinggi_badan,lingkar_kepala,tekanan_darah,status_stunting,status_gizi,flag_stunting,flag_gizi_buruk,flag_perlu_rujukan,flag_kek,flag_anemia,flag_risiko_tinggi&quot; +
&quot;) VALUES (&quot; +
&quot;'&quot; + id_hasil_pemeriksaan + &quot;'::int,&quot; +
(id_jadwal_imunisasi_oltp==null ? &quot;NULL&quot; : &quot;'&quot; + id_jadwal_imunisasi_oltp + &quot;'::int8&quot;) + &quot;,&quot; +
id_waktu_subq + &quot;,&quot; +
id_lokasi_subq + &quot;,&quot; +
id_dim_pasien_subq + &quot;,&quot; +
id_posyandu_subq + &quot;,&quot; +
id_dim_kehamilan_subq + &quot;,&quot; +
&quot;'&quot; + tipe_pasien + &quot;'::tipe_pasien,&quot; +
id_petugas_subq + &quot;,&quot; +
(berat_badan==null ? &quot;NULL&quot; : &quot;'&quot; + berat_badan + &quot;'::numeric&quot;) + &quot;,&quot; +
(tinggi_badan==null ? &quot;NULL&quot; : &quot;'&quot; + tinggi_badan + &quot;'::numeric&quot;) + &quot;,&quot; +
(lingkar_kepala==null ? &quot;NULL&quot; : &quot;'&quot; + lingkar_kepala + &quot;'::numeric&quot;) + &quot;,&quot; +
(tekanan_darah==null ? &quot;NULL&quot; : &quot;'&quot; + tekanan_darah.replace(/'/g,&quot;''&quot;) + &quot;'&quot;) + &quot;,&quot; +
(status_stunting==null ? &quot;NULL&quot; : &quot;'&quot; + status_stunting.replace(/'/g,&quot;''&quot;) + &quot;'&quot;) + &quot;,&quot; +
(status_gizi==null ? &quot;NULL&quot; : &quot;'&quot; + status_gizi.replace(/'/g,&quot;''&quot;) + &quot;'&quot;) + &quot;,&quot; +
(flag_stunting==null ? &quot;NULL&quot; : &quot;'&quot; + flag_stunting + &quot;'::int8&quot;) + &quot;,&quot; +
(flag_gizi_buruk==null ? &quot;NULL&quot; : &quot;'&quot; + flag_gizi_buruk + &quot;'::int8&quot;) + &quot;,&quot; +
(flag_perlu_rujukan==null ? &quot;NULL&quot; : &quot;'&quot; + flag_perlu_rujukan + &quot;'::int8&quot;) + &quot;,&quot; +
(flag_kek==null ? &quot;NULL&quot; : &quot;'&quot; + flag_kek + &quot;'::int8&quot;) + &quot;,&quot; +
(flag_anemia==null ? &quot;NULL&quot; : &quot;'&quot; + flag_anemia + &quot;'::int8&quot;) + &quot;,&quot; +
(flag_risiko_tinggi==null ? &quot;NULL&quot; : &quot;'&quot; + flag_risiko_tinggi + &quot;'::int8&quot;) +
&quot;) ON CONFLICT (id_hasil_pemeriksaan_oltp) DO UPDATE SET &quot; +
&quot;id_jadwal_imunisasi_oltp = EXCLUDED.id_jadwal_imunisasi_oltp,&quot; +
&quot;id_waktu = EXCLUDED.id_waktu,&quot; +
&quot;id_lokasi = EXCLUDED.id_lokasi,&quot; +
&quot;id_dim_pasien = EXCLUDED.id_dim_pasien,&quot; +
&quot;id_posyandu = EXCLUDED.id_posyandu,&quot; +
&quot;id_dim_kehamilan = EXCLUDED.id_dim_kehamilan,&quot; +
&quot;tipe_pasien = EXCLUDED.tipe_pasien,&quot; +
&quot;id_petugas = EXCLUDED.id_petugas,&quot; +
&quot;berat_badan = EXCLUDED.berat_badan,&quot; +
&quot;tinggi_badan = EXCLUDED.tinggi_badan,&quot; +
&quot;lingkar_kepala = EXCLUDED.lingkar_kepala,&quot; +
&quot;tekanan_darah = EXCLUDED.tekanan_darah,&quot; +
&quot;status_stunting = EXCLUDED.status_stunting,&quot; +
&quot;status_gizi = EXCLUDED.status_gizi,&quot; +
&quot;flag_stunting = EXCLUDED.flag_stunting,&quot; +
&quot;flag_gizi_buruk = EXCLUDED.flag_gizi_buruk,&quot; +
&quot;flag_perlu_rujukan = EXCLUDED.flag_perlu_rujukan,&quot; +
&quot;flag_kek = EXCLUDED.flag_kek,&quot; +
&quot;flag_anemia = EXCLUDED.flag_anemia,&quot; +
&quot;flag_risiko_tinggi = EXCLUDED.flag_risiko_tinggi &quot; +
&quot;WHERE FACT_PEMERIKSAAN.id_jadwal_imunisasi_oltp IS DISTINCT FROM EXCLUDED.id_jadwal_imunisasi_oltp &quot; +
&quot;OR FACT_PEMERIKSAAN.id_waktu IS DISTINCT FROM EXCLUDED.id_waktu &quot; +
&quot;OR FACT_PEMERIKSAAN.id_lokasi IS DISTINCT FROM EXCLUDED.id_lokasi &quot; +
&quot;OR FACT_PEMERIKSAAN.id_dim_pasien IS DISTINCT FROM EXCLUDED.id_dim_pasien &quot; +
&quot;OR FACT_PEMERIKSAAN.id_posyandu IS DISTINCT FROM EXCLUDED.id_posyandu &quot; +
&quot;OR FACT_PEMERIKSAAN.id_dim_kehamilan IS DISTINCT FROM EXCLUDED.id_dim_kehamilan &quot; +
&quot;OR FACT_PEMERIKSAAN.tipe_pasien IS DISTINCT FROM EXCLUDED.tipe_pasien &quot; +
&quot;OR FACT_PEMERIKSAAN.id_petugas IS DISTINCT FROM EXCLUDED.id_petugas &quot; +
&quot;OR FACT_PEMERIKSAAN.berat_badan IS DISTINCT FROM EXCLUDED.berat_badan &quot; +
&quot;OR FACT_PEMERIKSAAN.tinggi_badan IS DISTINCT FROM EXCLUDED.tinggi_badan &quot; +
&quot;OR FACT_PEMERIKSAAN.lingkar_kepala IS DISTINCT FROM EXCLUDED.lingkar_kepala &quot; +
&quot;OR FACT_PEMERIKSAAN.tekanan_darah IS DISTINCT FROM EXCLUDED.tekanan_darah &quot; +
&quot;OR FACT_PEMERIKSAAN.status_stunting IS DISTINCT FROM EXCLUDED.status_stunting &quot; +
&quot;OR FACT_PEMERIKSAAN.status_gizi IS DISTINCT FROM EXCLUDED.status_gizi &quot; +
&quot;OR FACT_PEMERIKSAAN.flag_stunting IS DISTINCT FROM EXCLUDED.flag_stunting &quot; +
&quot;OR FACT_PEMERIKSAAN.flag_gizi_buruk IS DISTINCT FROM EXCLUDED.flag_gizi_buruk &quot; +
&quot;OR FACT_PEMERIKSAAN.flag_perlu_rujukan IS DISTINCT FROM EXCLUDED.flag_perlu_rujukan &quot; +
&quot;OR FACT_PEMERIKSAAN.flag_kek IS DISTINCT FROM EXCLUDED.flag_kek &quot; +
&quot;OR FACT_PEMERIKSAAN.flag_anemia IS DISTINCT FROM EXCLUDED.flag_anemia &quot; +
&quot;OR FACT_PEMERIKSAAN.flag_risiko_tinggi IS DISTINCT FROM EXCLUDED.flag_risiko_tinggi&quot;;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>5000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute UPSERT</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Warehouse</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>99_End_ETL_Log_Success</name>
    <type>ExecSql</type>
    <description>End ETL execution logging with success status</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <execute_each_row>N</execute_each_row>
    <replace_variables>Y</replace_variables>
    <sql>SELECT public.end_etl_execution_success(
    '${execution_id}',
    0,  -- rows_inserted (will be updated by trigger if available)
    0,  -- rows_updated
    0   -- rows_deleted
)</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
