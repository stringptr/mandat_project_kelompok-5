<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_ibu_hamil</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load pregnant mother dimension (outrigger from DIM_PASIEN) - Incremental</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/06/13 13:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/06/14 22:50:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>00_Start_ETL_Log</from>
      <to>Read Ibu Hamil Data</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read Ibu Hamil Data</from>
      <to>Build SQL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build SQL</from>
      <to>Execute UPSERT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Execute UPSERT</from>
      <to>99_End_ETL_Log_Success</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>00_Start_ETL_Log</name>
    <type>TableInput</type>
    <description>Start ETL execution logging</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <sql>SELECT public.start_etl_execution(
    'MasterToWarehouse',
    'dim_ibu_hamil',
    'RunAll',
    'ibu_hamil',
    'DIM_IBU_HAMIL',
    ('{"LAST_ETL_RUN": "' || COALESCE('${LAST_ETL_RUN}', '1900-01-01') || '"}')::JSONB
) as execution_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Read Ibu Hamil Data</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Master</connection>
    <sql>SELECT 
  ih.id_ibu_hamil as id_ibu_hamil_oltp,
  ih.id_pasien,
  ih.hamil_ke,
  ih.status_kehamilan::VARCHAR,
  ih.hpht,
  ih.bulan_mulai_hamil,
  CASE 
    WHEN (CURRENT_DATE - ih.hpht) / 7 &lt;= 13 THEN 1
    WHEN (CURRENT_DATE - ih.hpht) / 7 &lt;= 26 THEN 2
    ELSE 3
  END as trimester
FROM ibu_hamil ih
WHERE ih.updated_at &gt;= COALESCE(NULLIF('${LAST_ETL_RUN}', ''), '1900-01-01')::TIMESTAMPTZ
  AND ih.is_deleted = false</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build SQL</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var hamilKeVal = (hamil_ke != null) ? &quot;'&quot; + hamil_ke + &quot;'::int&quot; : &quot;NULL&quot;;
var statusKehamilanVal = (status_kehamilan != null) ? &quot;'&quot; + status_kehamilan.replace(/'/g,&quot;''&quot;) + &quot;'&quot; : &quot;NULL&quot;;
var trimesterVal = (trimester != null) ? &quot;'&quot; + trimester + &quot;'::int&quot; : &quot;NULL&quot;;
var hphtVal = (hpht != null) ? &quot;'&quot; + hpht + &quot;'::date&quot; : &quot;NULL&quot;;
var bulanMulaiHamilVal = (bulan_mulai_hamil != null) ? &quot;'&quot; + bulan_mulai_hamil + &quot;'::date&quot; : &quot;NULL&quot;;

sql =
&quot;INSERT INTO public.DIM_IBU_HAMIL (&quot; +
&quot;id_dim_pasien,id_ibu_hamil_oltp,hamil_ke,status_kehamilan,trimester,hpht,bulan_mulai_hamil&quot; +
&quot;) VALUES (&quot; +
&quot;(SELECT id_dim_pasien FROM DIM_PASIEN WHERE id_pasien_oltp = '&quot; + id_pasien + &quot;' AND tipe_pasien = 'Ibu Hamil'::tipe_pasien),&quot; +
&quot;'&quot; + id_ibu_hamil_oltp + &quot;'::int8,&quot; +
hamilKeVal + &quot;,&quot; +
statusKehamilanVal + &quot;,&quot; +
trimesterVal + &quot;,&quot; +
hphtVal + &quot;,&quot; +
bulanMulaiHamilVal +
&quot;) ON CONFLICT (id_ibu_hamil_oltp) DO UPDATE SET &quot; +
&quot;id_dim_pasien = EXCLUDED.id_dim_pasien,&quot; +
&quot;hamil_ke = EXCLUDED.hamil_ke,&quot; +
&quot;status_kehamilan = EXCLUDED.status_kehamilan,&quot; +
&quot;trimester = EXCLUDED.trimester,&quot; +
&quot;hpht = EXCLUDED.hpht,&quot; +
&quot;bulan_mulai_hamil = EXCLUDED.bulan_mulai_hamil &quot; +
&quot;WHERE DIM_IBU_HAMIL.id_dim_pasien IS DISTINCT FROM EXCLUDED.id_dim_pasien &quot; +
&quot;OR DIM_IBU_HAMIL.hamil_ke IS DISTINCT FROM EXCLUDED.hamil_ke &quot; +
&quot;OR DIM_IBU_HAMIL.status_kehamilan IS DISTINCT FROM EXCLUDED.status_kehamilan &quot; +
&quot;OR DIM_IBU_HAMIL.trimester IS DISTINCT FROM EXCLUDED.trimester &quot; +
&quot;OR DIM_IBU_HAMIL.hpht IS DISTINCT FROM EXCLUDED.hpht &quot; +
&quot;OR DIM_IBU_HAMIL.bulan_mulai_hamil IS DISTINCT FROM EXCLUDED.bulan_mulai_hamil&quot;;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql</rename>
        <type>String</type>
        <length>2000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute UPSERT</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>Warehouse</connection>
    <sendOneStatement>Y</sendOneStatement>
    <sqlFromfile>N</sqlFromfile>
    <sql_field>sql</sql_field>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>99_End_ETL_Log_Success</name>
    <type>ExecSql</type>
    <description>End ETL execution logging with success status</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Warehouse</connection>
    <execute_each_row>N</execute_each_row>
    <replace_variables>Y</replace_variables>
    <sql>SELECT public.end_etl_execution_success(
    '${execution_id}',
    0,  -- rows_inserted (will be updated by trigger if available)
    0,  -- rows_updated
    0   -- rows_deleted
)</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
